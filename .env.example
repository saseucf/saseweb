# Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public membership checkout configuration
NEXT_PUBLIC_ZEFFY_MEMBERSHIP_URL=https://www.zeffy.com/en-US/ticketing/society-of-asian-scientists-and-engineerss-memberships

# Server-only Zeffy payment reconciliation configuration
ZEFFY_API=
ZEFFY_CAMPAIGN_ID=c1f40aba-bcb9-4da8-9f6e-2cc57ad71e3a
ZEFFY_EXPECTED_AMOUNT_CENTS=2500
ZEFFY_EXPECTED_CURRENCY=USD
MEMBERSHIP_PERIOD=2026-2027

# Contact & Help: server-only email and verification configuration.
# CONTACT_FROM_EMAIL must be a bare email on a Resend-verified sending domain.
# See docs/contact-help.md. Never use production credentials in committed files.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# The widget site key is public and passed to /contact by the server.
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET_KEY=
# Comma-separated exact origins, no trailing slashes. Add production/preview hosts explicitly.
CONTACT_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

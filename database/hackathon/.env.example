# Use the SAME project URL/key as the SASE website. Accounts are shared.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-EXISTING-SASE-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Only needed for trusted server automation; never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-KEY
